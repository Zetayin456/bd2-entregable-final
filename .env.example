# Copiar como .env local. No reutilizar estos marcadores como contraseñas.
# Para generar un secreto: PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))

# Usuario administrador técnico de CouchDB (distinto del admin de la aplicación).
COUCHDB_USER=couchdb_admin
COUCHDB_PASSWORD=CAMBIAR_POR_PASSWORD_ALEATORIO

# Secreto compartido entre CouchDB y el backend para autenticación proxy.
COUCHDB_PROXY_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_48_BYTES

# Clave de firma de JWT; independiente del secreto de CouchDB.
JWT_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_48_BYTES

# Usuario inicial de la aplicación, creado por couchdb-init.
BOOTSTRAP_ADMIN_USER=admin_plataforma
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_DE_AL_MENOS_12_CARACTERES
